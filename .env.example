GEMMA_API_KEY=your_gemma_api_key_here
# Powers the Gemma doctor reports (default model gemma-4-31b-it; override with GEMMA_MODEL).
# (GEMINI_API_KEY is also accepted as an alias for the same key.)
GEMMA_MODEL=gemma-4-31b-it
# Get a key at https://aistudio.google.com/apikey
# Required package is already installed: google-genai
# Without this key the app still works — reports show "Gemma 4 API not configured".
